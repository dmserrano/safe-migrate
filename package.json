{
  "name": "safe-migrate",
  "version": "0.0.1",
  "description": "Migration-aware characterization test generator for legacy JS codebases",
  "type": "module",
  "bin": {
    "safe-migrate": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/cli.js",
    "calibrate": "npm run build && node dist/scripts/calibrate-mutation-threshold.js",
    "test": "node --test",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^8.0.4",
    "@stryker-mutator/api": "^9.6.1",
    "@stryker-mutator/core": "^9.6.1",
    "commander": "^12.0.0",
    "execa": "^9.0.0",
    "fast-glob": "^3.3.3",
    "picocolors": "^1.0.0",
    "testcontainers": "^12.1.0"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
